# Copy to .env and adjust. No secrets here: the API token is typed into the
# panel's sign-in page and kept in the browser tab only.

# Where the panel forwards /api/ and /probe/: a scanner replica, or a load
# balancer in front of the replicas. Used by `npm run dev` and by the image's
# nginx (at container start). In the compose stack: http://scanner-1:8080
API_URL=http://127.0.0.1:8080

# The address the panel is served at. Its path is the base path of the build
# (use for example https://ops.example/scanner/ to serve it under /scanner/);
# its host and port are where `npm run dev` listens. The Docker image serves the
# build at /, so keep the path / there.
PANEL_URL=http://localhost:5173/
