# Copy to .env, fill it in, chmod 600 .env. Never commit .env.
# Compose interpolates $ in this file: write a robot name robot$scanner as robot$$scanner.

# API token for /api/v2 and the admin panel's sign-in (at least 32 characters).
SCANNER_V2_AUTH_TOKEN=replace-with-at-least-32-random-characters

# MongoDB user and password (created on the first start). Use letters and digits:
# they are put into the MongoDB URI as they are.
MONGO_USER=scanner
MONGO_PASSWORD=replace-me

# The Harbor (or registry) the scanner reads images from, and its robot account.
SCANNER_REGISTRY_URL=https://harbor.example.internal
SCANNER_REGISTRY_USERNAME=robot$$scanner
SCANNER_REGISTRY_PASSWORD=replace-me

# DB sources, tried in order: Liara's ghcr.io mirror, Liara's Docker Hub mirror,
# then Docker Hub itself (https://liara.ir/mirrors/). ghcr.io is not used. Both
# Liara mirrors speak only HTTP/1.1, so they need |allow-http1.
SCANNER_DB_SOURCES=ghcr-mirror.liara.ir/aquasecurity/trivy-db:2|direct|allow-http1,docker-mirror.liara.ir/aquasec/trivy-db:2|direct|allow-http1,docker.io/aquasec/trivy-db:2|direct
SCANNER_JAVA_DB_SOURCES=ghcr-mirror.liara.ir/aquasecurity/trivy-java-db:1|direct|allow-http1,docker-mirror.liara.ir/aquasec/trivy-java-db:1|direct|allow-http1,docker.io/aquasec/trivy-java-db:1|direct

# The Harbor adapter (v1) downloads its own DBs with Trivy; point it at Liara's ghcr.io mirror too.
SCANNER_TRIVY_DB_REPOSITORY=ghcr-mirror.liara.ir/aquasecurity/trivy-db:2
SCANNER_TRIVY_JAVA_DB_REPOSITORY=ghcr-mirror.liara.ir/aquasecurity/trivy-java-db:1

# Workers per replica (each needs about 2 GB; see SCANNER_MEM_LIMIT).
SCANNER_QUEUE_WORKERS=2
SCANNER_MEM_LIMIT=5g

# Optional: one DNS server for the scanners (empty: Docker's default).
SCANNER_DNS=

# The admin panel's host port (127.0.0.1 only by default): http://127.0.0.1:8088
ADMIN_BIND=127.0.0.1
ADMIN_PORT=8088

# Go module mirror for the scanner image build: Liara's (https://liara.ir/mirrors/).
# Leave it empty to use the public proxy.golang.org.
GOPROXY=https://package-mirror.liara.ir/repository/go/
